{
  "name": "techfix/laptop-repair",
  "description": "TechFix Laptop Repair Management System",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "vlucas/phpdotenv": "^5.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "start": "php -S localhost:8000 server.php",
    "serve": "php -S localhost:8000 server.php",
    "dev": "php -S localhost:8000 server.php",
    "migrate": "php database/migrate.php",
    "migrate:seed": "php database/migrate.php --seed",
    "migrate:fresh": "php database/migrate.php --fresh",
    "db:seed": "php database/seed.php",
    "db:sample": "php database/seed.php --sample"
  }
}
