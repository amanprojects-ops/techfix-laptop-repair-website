# ============================================================
# TechFix Laptop Repair — Root Apache Configuration for Shared Hosting
# ============================================================

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Pass Authorization Headers
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Prevent loop if already rewritten to public
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # If static asset exists in public folder, rewrite directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]

    # Route root requests to public/
    RewriteRule ^$ public/ [L]
</IfModule>

# Block sensitive directories and files from direct web access
<FilesMatch "^\.(env|git|gitignore)">
    Order allow,deny
    Deny from all
</FilesMatch>
